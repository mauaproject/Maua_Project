Options -Indexes

<FilesMatch "\.(?:php[0-9]*|phtml|phar|cgi|pl|py|sh|html?|svg)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    <FilesMatch "\.webp$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
